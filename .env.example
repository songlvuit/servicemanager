# ---------------------------------------------------------------------------
# Ứng dụng
# ---------------------------------------------------------------------------
APP_NAME="Service Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Cổng Nginx mở ra trên máy chủ (đổi nếu cổng 80 đã có ứng dụng khác dùng).
APP_PORT=80

APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

# Tự chạy migration + đồng bộ vai trò/quyền mỗi lần container app khởi động.
AUTO_MIGRATE=true

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Quy tắc báo giá (xem config/quotation.php)
# ---------------------------------------------------------------------------
QUOTATION_VALIDITY_DAYS=30
QUOTATION_DEFAULT_TAX_RATE=10
# Biên lợi nhuận (%) dưới mức này thì cảnh báo "Biên lợi nhuận thấp."
QUOTATION_LOW_MARGIN_THRESHOLD=20
# Chiết khấu (%) vượt mức này thì bắt buộc Giám đốc duyệt.
QUOTATION_DIRECTOR_DISCOUNT_THRESHOLD=20
# Cơ sở tính lợi nhuận: subtotal (trước thuế) hoặc total (sau thuế).
QUOTATION_PROFIT_BASE=subtotal

# ---------------------------------------------------------------------------
# Quy tắc công việc, hợp đồng, hóa đơn (xem config/job.php, config/billing.php).
# Đây là giá trị MẶC ĐỊNH: giá trị sửa ở Hệ thống → Cấu hình được ưu tiên.
# ---------------------------------------------------------------------------
# Cảnh báo khi chi phí thực tế của công việc đạt từ X% ngân sách.
JOB_BUDGET_WARNING_THRESHOLD=80
# Nhắc hợp đồng sắp hết hạn trước bao nhiêu ngày.
CONTRACT_EXPIRY_WARNING_DAYS=30
# Đánh giá biên lợi nhuận hợp đồng (%): trên GOOD là tốt, dưới WARNING là cảnh báo, dưới DANGER là nguy hiểm.
JOB_MARGIN_GOOD=30
JOB_MARGIN_WARNING=20
JOB_MARGIN_DANGER=10
# Hạn thanh toán mặc định của hóa đơn (ngày), thuế GTGT mặc định (%), nhắc trước hạn (ngày).
INVOICE_PAYMENT_TERM_DAYS=30
INVOICE_DEFAULT_TAX_RATE=10
INVOICE_DUE_REMINDER_DAYS=7

# ---------------------------------------------------------------------------
# PostgreSQL (container "postgres" trong docker-compose.yml)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=service_manager
DB_USERNAME=service_manager
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Redis (container "redis"): cache, session, queue
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# Lưu trữ file: "local" khi phát triển; có thể chuyển sang "s3" (S3 / GCS
# tương thích S3) mà không phải sửa code.
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Email ("log" = ghi email vào storage/logs thay vì gửi thật)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
